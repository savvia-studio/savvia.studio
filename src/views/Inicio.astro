---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Carriles from '../components/Carriles.astro';
import Cargador from '../components/Cargador.astro';
import Hero from '../components/Hero.astro';
import Raices from '../components/Raices.astro';
// import Dolores from '../components/Dolores.astro'; // ronda 51 · la A2 (raíz + demos); ronda 65: fuera las pruebas A y B (DoloresB.astro queda guardada)
import LaSavvia from '../components/LaSavvia.astro'; // ronda 53: guardada (la sustituye LaReceta)
import LaReceta from '../components/LaReceta.astro'; // ronda 125: guardada (la sustituye LaPartitura, savvia agentic)
import LaPartitura from '../components/LaPartitura.astro';
import Proyectos from '../components/Proyectos.astro';
import Anteriores from '../components/Anteriores.astro';
import Servicios from '../components/Servicios.astro';
import Estudio from '../components/Estudio.astro';
import Preguntas from '../components/Preguntas.astro';
import Pie from '../components/Pie.astro';
// SEO (2/11) · lo que lee Google: la descripción del resultado y los datos estructurados (la entidad va en Base). Sin tocar el copy.
import { langDe } from '../lib/i18n';
import { fichasDe } from '../data/idioma';
import { DESCRIPCION_BUSCADOR, paginaWeb, preguntasFrecuentes, SITIO } from '../lib/seo';
const lang = langDe(Astro.currentLocale);
const urlPagina = new URL(Astro.url.pathname, SITIO).href;
---

<Base descripcionBuscador={DESCRIPCION_BUSCADOR[lang]} jsonLd={[paginaWeb(lang, urlPagina, lang === 'en' ? 'savvia: AI with judgement' : 'savvia: IA con criterio', DESCRIPCION_BUSCADOR[lang]), preguntasFrecuentes(fichasDe(lang).filter((f) => f.chip))]}>
  <Nav />
  <Carriles />
  <Cargador />
  <main id="contenido">
    <!-- RONDA 39 · «reestructuramos la web: hero > pains > proyectos destacados > nuestros proyectos > servicios > savvia es la receta de
         tu web > equipo > FAQs > footer» -->
    <Hero />
    <Raices />
    <!-- RONDA 65 · la sección 2 elegida es la A2; `data-s2` se queda porque el CSS del titular generado cuelga de él -->
    <script is:inline>document.documentElement.dataset.s2 = 'a2';</script>
    <!-- RONDA 292 · reunión con JL: hero › mockup (con el reel en bucle) › savvia agentic (manifiesto + ilustración) › grid de logos y testimonios › proyectos -->
    <Proyectos />
    <LaPartitura />
    <Anteriores />
    <Servicios />
    <Estudio />
    <Preguntas />
  </main>
  <Pie chatConBoton />
</Base>

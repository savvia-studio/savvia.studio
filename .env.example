# Copy to .env and fill in. Without these keys the site works, only the contact brief and the chat do not.

# Chat (api/preguntar.js) · https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Contact brief by email (api/brief.js) · https://resend.com
RESEND_API_KEY=
BRIEF_PARA=you@example.com
BRIEF_DE=Your site <web@example.com>

# Rate limiting for both (api/brief.js, api/preguntar.js) · https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
